      "within_lines": 3
    },
    {
      "name": "nonpositive frequency is handled before period division",
      "path": "src/components/sources/acvoltage.cpp",
      "ordered": [
        "if ( m_freq > 0 ) {",
        "m_psPerCycleDbl = psPerSecond / m_freq;",
        "} else {",
        "m_psPerCycleDbl = 0;"
      ],
      "within_lines": 13
    },
    {
      "name": "frequency is limited to one hundred samples at picosecond resolution",
      "path": "src/components/sources/acvoltage.cpp",
      "contains": [
        "constexpr double maxFrequency = psPerSecond / samplesPerCycle;",
        "m_freq = std::max( 0.0, std::min( frequency, maxFrequency ) );"
      ]
    },
    {
      "name": "waveform uses smooth self-scheduled updates with at least one hundred samples per cycle",
      "path": "src/components/sources/acvoltage.cpp",
      "contains": [
        "constexpr double maxEventStep = 1e6;",
        "constexpr int samplesPerCycle = 100;",
