      "path": "src/components/sources/acvoltage.cpp",
      "ordered": [
        "if ( !m_isRunning || m_freq <= 0 || m_psPerCycleDbl <= 0 ) {",
        "m_outpin->setVoltage( 0 );",
        "return;"
      ],
