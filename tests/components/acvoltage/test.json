      "contains": [
        "AcVoltage::~AcVoltage()",
        "Simulator::self()->cancelEvents( this );",
        "if ( m_isRunning && m_eventStepInt > 0 )\n        Simulator::self()->addEvent( m_eventStepInt, this );"
      ]
