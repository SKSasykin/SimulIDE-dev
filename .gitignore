build_XX/SimulIDE_Build.pro.user
build_XX/.qmake.stash
build_XX/build/
build_XX/executables/
build_XX/qrc_application.cpp
build_XX/ui_*.h
# qemu module build products (see scripts/build_qemu.sh)
build_XX/qemu-simulide/
